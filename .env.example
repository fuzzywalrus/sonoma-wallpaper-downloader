# Apple Code Signing and Notarization Credentials
# Copy this file to .env and fill in your values

# Your Apple ID email
APPLE_ID=your@email.com

# App-specific password from appleid.apple.com
# Generate at: https://appleid.apple.com -> Security -> App-Specific Passwords
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your Apple Developer Team ID
APPLE_TEAM_ID=36SA478KNK

# Code signing identity (optional override; default matches this project)
APPLE_SIGNING_IDENTITY="Developer ID Application: Greg Gant (36SA478KNK)"

# Debug notarization (optional)
DEBUG=electron-notarize*
